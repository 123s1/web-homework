# ===== 博物馆预约系统 Linux 部署配置示例 =====
# 复制为 deploy.env 后按实际环境修改：
#   cp deploy.env.example deploy.env
# 所有部署脚本都会自动读取同目录下的 deploy.env。
# 注意：deploy.env 含有数据库密码，已在 .gitignore 中忽略，请勿提交到仓库。

# ---- 数据库连接（后端运行时使用）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=museum_reservation
DB_USERNAME=museum
DB_PASSWORD=Museum@123456

# ---- 仅初始化数据库时使用的 MySQL root 密码 ----
# 01-init-database.sh 会用 root 创建数据库、导入表结构、并创建上面的 DB_USERNAME 账号。
# 如果你的 MySQL root 是无密码（全新 apt 安装常见），留空即可。
MYSQL_ROOT_PASSWORD=

# ---- 后端服务端口 ----
SERVER_PORT=8080

# ---- 前端对外访问端口（Nginx 监听端口）----
HTTP_PORT=80

# ---- 部署目录（jar 包、前端静态文件、日志的存放位置）----
APP_HOME=/opt/museum-reservation

# ---- 运行后端服务的系统用户 ----
RUN_USER=museum
